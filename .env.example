# Supabase credentials (get them from your Supabase project settings -> API)
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Google AI Studio Gemini API Key for Screenshot Vision OCR (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

